# Copy to .env and fill in locally. Never commit .env. Meanings: spec.md §3.1.

# Server DB (local docker compose default shown)
DATABASE_URL=postgresql://spira:spira@localhost:5432/spira

# Knowledge base DB, read-only account (KB-13)
KB_DATABASE_URL=
# Knowledge base DB, owner account, migrations only (Seojin)
KB_MIGRATION_URL=
# Knowledge base version to search, e.g. kb-v1 (versions are cumulative)
KB_VERSION=

# LLM: anthropic / openai / gemini / mock
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=60

# Embedding: bge (BGE-M3, needs the embed extra) / mock (tests)
EMBED_MODE=bge

# App bearer token (demo)
APP_DEMO_TOKEN=

# Evaluation switches (spec §15). KB_MODE=on needs KB_DATABASE_URL and KB_VERSION
KB_MODE=off
HOME_CONTEXT=on
KB_SAMPLE=1.0
OTHER_HOME=off

# 1 = shortened starting values for demos (COM-15)
DEMO_MODE=0
IMAGE_DIR=/tmp/spira-images
CALENDAR_HMAC_KEY=
TZ=Asia/Seoul
