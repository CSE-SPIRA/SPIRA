{
  "household_id": "h_051",
  "display_name": "부모님 댁",
  "demo_people": [
    {
      "name": "할머니",
      "role": "resident"
    },
    {
      "name": "할아버지",
      "role": "resident"
    },
    {
      "name": "손님",
      "role": "guest"
    }
  ],
  "devices": [
    {
      "target": "mqtt:cleaner_01",
      "logical_id": "cleaner_01",
      "device_type": "cleaner",
      "room": "living_room",
      "substrate": "virtual",
      "available": true,
      "local_operation_reporting": true,
      "assumption": "Virtual LG local-operation reporting",
      "commands": [
        {
          "cmd": "clean",
          "value_schema": {
            "room": {
              "enum": [
                "거실",
                "주방",
                "침실"
              ],
              "default": "거실"
            }
          }
        }
      ],
      "command_basis": {
        "clean": "sdk"
      },
      "properties": {
        "clean": {
          "initial": null,
          "schema": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "room": {
                    "enum": [
                      "거실",
                      "주방",
                      "침실"
                    ]
                  }
                },
                "required": [
                  "room"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "in_use": {
          "initial": false,
          "schema": {
            "type": "boolean"
          },
          "hub_write": false,
          "local_write": false
        },
        "job_status": {
          "initial": "idle",
          "schema": {
            "enum": [
              "idle",
              "running",
              "completed",
              "stopped"
            ]
          },
          "hub_write": false,
          "local_write": false
        }
      },
      "job": {
        "trigger_property": "clean",
        "duration_seconds": 30
      },
      "label": "청소기"
    },
    {
      "target": "mqtt:speaker_01",
      "logical_id": "speaker_01",
      "device_type": "speaker",
      "room": "living_room",
      "substrate": "virtual",
      "available": true,
      "local_operation_reporting": false,
      "commands": [
        {
          "cmd": "play",
          "value_schema": {
            "playlist": {
              "enum": [
                "calm",
                "party",
                "family"
              ],
              "default": "calm"
            },
            "volume": {
              "range": [
                0,
                100
              ],
              "default": 30
            }
          }
        },
        {
          "cmd": "stop"
        }
      ],
      "command_basis": {
        "play": "lg_assumed",
        "stop": "lg_assumed"
      },
      "properties": {
        "play": {
          "initial": null,
          "schema": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "playlist": {
                    "enum": [
                      "calm",
                      "party",
                      "family"
                    ]
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "playlist",
                  "volume"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "label": "스피커",
      "never": [
        "purchase"
      ]
    },
    {
      "target": "mqtt:oven_01",
      "logical_id": "oven_01",
      "device_type": "oven",
      "room": "kitchen",
      "substrate": "virtual",
      "available": true,
      "local_operation_reporting": true,
      "assumption": "Virtual LG local-operation reporting",
      "commands": [
        {
          "cmd": "set_cook_standby",
          "value_schema": {
            "temp_c": {
              "range": [
                40,
                250
              ],
              "default": 180
            },
            "minutes": {
              "range": [
                1,
                180
              ],
              "default": 20
            }
          }
        }
      ],
      "command_basis": {
        "set_cook_standby": "lg_assumed"
      },
      "properties": {
        "preset": {
          "initial": null,
          "schema": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "temp_c": {
                    "type": "number",
                    "minimum": 40,
                    "maximum": 250
                  },
                  "minutes": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 180
                  }
                },
                "required": [
                  "temp_c",
                  "minutes"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "in_use": {
          "initial": false,
          "schema": {
            "type": "boolean"
          },
          "hub_write": false,
          "local_write": false
        },
        "job_status": {
          "initial": "idle",
          "schema": {
            "enum": [
              "idle",
              "running",
              "completed",
              "stopped"
            ]
          },
          "hub_write": false,
          "local_write": false
        }
      },
      "job": {
        "duration_seconds": 1200,
        "minutes_property": "preset"
      },
      "prohibited_properties": [
        "start",
        "in_use"
      ],
      "label": "오븐",
      "never": [
        "start"
      ]
    },
    {
      "target": "mqtt:fridge_01",
      "logical_id": "fridge_01",
      "device_type": "fridge",
      "room": "kitchen",
      "substrate": "virtual",
      "available": true,
      "local_operation_reporting": true,
      "assumption": "Virtual LG local-operation reporting",
      "commands": [
        {
          "cmd": "show_notice",
          "value_schema": "text"
        },
        {
          "cmd": "clear_notice"
        }
      ],
      "command_basis": {
        "show_notice": "lg_assumed",
        "clear_notice": "lg_assumed"
      },
      "properties": {
        "show_notice": {
          "initial": null,
          "schema": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "door_open": {
          "initial": false,
          "schema": {
            "type": "boolean"
          },
          "hub_write": false,
          "event_type": "fridge.door_opened"
        }
      },
      "label": "냉장고"
    },
    {
      "target": "mqtt:air_purifier_01",
      "logical_id": "air_purifier_01",
      "device_type": "purifier",
      "room": "living_room",
      "substrate": "virtual",
      "available": true,
      "local_operation_reporting": true,
      "assumption": "Virtual LG local-operation reporting",
      "commands": [
        {
          "cmd": "mode",
          "value_schema": {
            "mode": {
              "enum": [
                "CLEAN",
                "AUTO",
                "CIRCULATOR",
                "DUAL_CLEAN"
              ],
              "default": "CLEAN"
            }
          }
        },
        {
          "cmd": "wind_strength",
          "value_schema": {
            "wind_strength": {
              "enum": [
                "LOW",
                "MID",
                "HIGH",
                "AUTO",
                "POWER"
              ],
              "default": "MID"
            }
          }
        }
      ],
      "command_basis": {
        "mode": "sdk",
        "wind_strength": "sdk"
      },
      "properties": {
        "mode": {
          "initial": "CLEAN",
          "schema": {
            "enum": [
              "CLEAN",
              "AUTO",
              "CIRCULATOR",
              "DUAL_CLEAN"
            ]
          }
        },
        "wind_strength": {
          "initial": "MID",
          "schema": {
            "enum": [
              "LOW",
              "MID",
              "HIGH",
              "AUTO",
              "POWER"
            ]
          }
        }
      },
      "label": "공기청정기"
    }
  ],
  "home_signals": {
    "delivery": [
      {
        "target": "mqtt:sim_camera",
        "event_type": "camera.package_removed",
        "payload": {
          "removed_count": 1,
          "remaining_count": 0
        }
      }
    ],
    "guests_arrive": [
      {
        "target": "mqtt:sim_doorbell",
        "event_type": "doorbell.pressed",
        "payload": {}
      },
      {
        "target": "mqtt:sim_door_lock",
        "event_type": "door_lock.opened",
        "payload": {}
      },
      {
        "target": "mqtt:sim_presence",
        "event_type": "presence.room_occupied",
        "payload": {}
      }
    ],
    "event_end": [
      {
        "target": "mqtt:sim_presence",
        "event_type": "presence.room_empty",
        "payload": {}
      }
    ]
  }
}
