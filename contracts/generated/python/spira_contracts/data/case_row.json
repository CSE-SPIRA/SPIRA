{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case_row.json",
  "title": "CaseRow",
  "description": "One row of the cases table (C-5). synthetic rows: written by SPIRA_KB. this_home rows: written by the server, one per card (intent). Columns match server/migrations/versions/0001_create_cases.py. (KB-05, KB-06)",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "source", "items", "intent_id", "intent_text", "situation", "when", "household", "kb_version"],
  "properties": {
    "case_id": {"$ref": "common.json#/$defs/CaseId"},
    "source": {"$ref": "common.json#/$defs/CaseSource"},
    "items": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Plain item names of the whole order, sorted (가나다), masked items excluded, no quantities."},
    "intent_id": {"type": "string"},
    "intent_text": {"type": ["string", "null"]},
    "situation": {"$ref": "#/$defs/Situation"},
    "when": {
      "type": "object", "additionalProperties": false, "required": ["weekday", "calendar_tags"],
      "properties": {
        "weekday": {"enum": ["월", "화", "수", "목", "금", "토", "일"], "description": "synthetic: arrival weekday. this_home: weekday of executed_at."},
        "calendar_tags": {"type": "array", "items": {"type": "string"}},
        "executed_at": {"$ref": "common.json#/$defs/DateTime", "description": "this_home only: first preparation run."}
      }
    },
    "household": {
      "type": "object", "additionalProperties": false, "required": ["types"],
      "properties": {"types": {"type": ["array", "null"], "items": {"type": "string"}}}
    },
    "basket_emb": {"type": "array", "items": {"type": "number"}, "minItems": 1024, "maxItems": 1024, "description": "BGE-M3 via spira.embedding.embed_basket (KB-16). Omitted in fixtures."},
    "kb_version": {"type": ["string", "null"], "pattern": "^kb-v[0-9]+$", "description": "synthetic: first KB version the case entered. this_home: null."},
    "household_id": {"$ref": "common.json#/$defs/HouseholdId"},
    "home_did": {"type": "array", "items": {"$ref": "#/$defs/HomeDid"}},
    "verdict": {"$ref": "common.json#/$defs/Verdict"},
    "task_feedback": {"type": "array", "items": {"$ref": "#/$defs/Feedback"}}
  },
  "if": {"properties": {"source": {"const": "this_home"}}},
  "then": {
    "required": ["household_id", "home_did", "verdict", "task_feedback"],
    "properties": {"when": {"required": ["executed_at"]}}
  },
  "else": {
    "not": {"anyOf": [{"required": ["household_id"]}, {"required": ["home_did"]}, {"required": ["verdict"]}, {"required": ["task_feedback"]}]}
  },
  "$defs": {
    "Situation": {
      "type": "object", "additionalProperties": false, "required": ["event", "guests", "activity", "theme"],
      "properties": {
        "event": {"type": ["string", "null"]}, "guests": {"type": ["string", "null"]},
        "activity": {"type": ["string", "null"]}, "theme": {"type": ["string", "null"]}
      }
    },
    "HomeDid": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "line", "way", "actions", "ran"],
      "properties": {
        "task_id": {"$ref": "common.json#/$defs/TaskId"},
        "line": {"type": "string"},
        "way": {"$ref": "common.json#/$defs/Way"},
        "actions": {"type": "array", "items": {"$ref": "common.json#/$defs/ActionKey"}},
        "ran": {"type": "boolean"}
      }
    },
    "Feedback": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "actions", "user"],
      "description": "Final state of one card line when the observation window closed.",
      "properties": {
        "task_id": {"$ref": "common.json#/$defs/TaskId"},
        "actions": {"type": "array", "items": {"$ref": "common.json#/$defs/ActionKey"}},
        "user": {"$ref": "common.json#/$defs/TaskFeedback"},
        "when": {"$ref": "common.json#/$defs/OffWhen", "description": "off only."},
        "at": {"$ref": "common.json#/$defs/Date", "description": "off only: the day it was switched off."},
        "changes": {
          "type": "array", "description": "changed only.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["device_type", "property", "to", "after_start_minutes"],
            "properties": {
              "device_type": {"type": "string"},
              "property": {"type": "string"},
              "to": {"description": "Value the person set, e.g. {\"kelvin\": 2700}."},
              "after_start_minutes": {"type": "integer", "description": "Minutes after the schedule start."}
            }
          }
        }
      }
    }
  }
}
