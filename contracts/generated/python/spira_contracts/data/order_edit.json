{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_edit.json",
  "title": "OrderEdit",
  "description": "App -> server: PUT /v1/episodes/{id}/order. The full corrected item list; items without item_id are new. The server judges again from S2; only tasks not started yet change. (APP-07)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "qty"],
        "properties": {
          "item_id": {"$ref": "common.json#/$defs/ItemId"},
          "name": {"type": "string", "minLength": 1},
          "qty": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  }
}
