{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory.json",
  "title": "Memory",
  "description": "This home's memory grouped by intent (intent id + calendar tags). Server -> app: GET /v1/households/{hid}/memory; delete one case with DELETE .../memory/{case_id}. (APP-15)",
  "type": "object",
  "additionalProperties": false,
  "required": ["household_id", "intents"],
  "properties": {
    "household_id": {"$ref": "common.json#/$defs/HouseholdId"},
    "intents": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["intent_id", "name", "calendar_tags", "episodes", "off_lines", "changed", "habit_time"],
        "properties": {
          "intent_id": {"type": "string"},
          "name": {"type": "string"},
          "calendar_tags": {"type": "array", "items": {"type": "string"}},
          "episodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "date", "verdict"], "properties": {"case_id": {"$ref": "common.json#/$defs/CaseId"}, "date": {"$ref": "common.json#/$defs/Date"}, "verdict": {"$ref": "common.json#/$defs/Verdict"}}}},
          "off_lines": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["line", "until", "case_id"], "properties": {"line": {"type": "string"}, "until": {"$ref": "common.json#/$defs/Date", "description": "Left out of new plans until this day (180 days)."}, "case_id": {"$ref": "common.json#/$defs/CaseId"}}}},
          "changed": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["device_type", "change", "case_id"], "properties": {"device_type": {"type": "string"}, "change": {"type": "string", "description": "Display text."}, "case_id": {"$ref": "common.json#/$defs/CaseId"}}}},
          "habit_time": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["weekday", "time"], "properties": {"weekday": {"type": "string"}, "time": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"}}}]}
        }
      }
    }
  }
}
